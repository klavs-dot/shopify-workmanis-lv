# --- 14d.lv public storefront (apps/store) ---
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is .gitignored.

# Public site URL (used for canonical, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://14d.lv

# Search engine indexing. Keep empty/false until launch (site is noindex);
# set to "true" in Vercel Production env on go-live.
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Shopify Storefront API (server-only; read by lib/shopify) ---
# None of these may ever get a NEXT_PUBLIC_ prefix.
#
# Store domain:
#   empty              → mock catalogue (lib/mock-products.ts), ordering off
#   mock.shop          → Shopify's public test API https://mock.shop/api
#                        (no token needed, CAD prices) — for development
#   xxxx.myshopify.com → the real store (needs the private token below)
SHOPIFY_STORE_DOMAIN=

# Private Storefront token — Shopify Admin → Sales channels → Headless →
# (storefront) → Storefront API → Private access token. Sent as
# Shopify-Storefront-Private-Token. Needs the product listings, product
# inventory, product tags and checkouts scopes. Without it a real domain does
# NOT fall back to mock data: every Storefront request fails and the site
# shows its "catalog unavailable" state (plus an error in the server log).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Storefront API version (quarterly; keep within Shopify's support window).
SHOPIFY_API_VERSION=2026-07

# Signing secret for the catalog revalidation webhook (POST /api/revalidate)
# — Shopify Admin → Settings → Notifications → Webhooks.
SHOPIFY_WEBHOOK_SECRET=

# NOTE: the Shopify Admin API token must never live in this app —
# admin sync belongs to the admin system (repo root).
