# --- 14d.lv public storefront (apps/store) ---
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is .gitignored.

# Public site URL (used for canonical, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://14d.lv

# Shopify Storefront API — public read access (safe to expose, but not stored
# in git). Get from: Shopify Admin → Apps → Develop apps → Storefront API access.
NEXT_PUBLIC_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-04

# Shopify Admin API token — server-side, NEVER prefix with NEXT_PUBLIC_.
# The public storefront should NOT use Admin API; it is here only for
# server actions that need to read non-public catalog metadata (rare).
# In most cases, leave this empty — admin sync lives in apps/admin.
SHOPIFY_ADMIN_API_TOKEN=
