# --- 14d.lv public storefront (apps/store) ---
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is .gitignored.

# Public site URL (used for canonical, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://14d.lv

# Search engine indexing. Keep empty/false until launch (site is noindex);
# set to "true" in Vercel Production env on go-live.
NEXT_PUBLIC_ALLOW_INDEXING=

# Shopify Storefront API — from Shopify Admin → Sales channels → Headless →
# Storefront API. Server-side only; never prefix the token with NEXT_PUBLIC_.
NEXT_PUBLIC_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# NOTE: the Shopify Admin API token must never live in this app —
# admin sync belongs to the admin system (repo root).
