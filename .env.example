# ========================================================================
# shopify.workmanis.lv — SEPARATE Firebase project from Workmanis.lv
# Do NOT reuse the existing Workmanis Firebase credentials here.
# ========================================================================

# Firebase Web SDK (public values from Firebase console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: enable Firebase emulators in local dev (1 = on)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# Server-only — used by scripts/seed-master.ts to create the first MASTER user
# Generate via: Firebase console → Project settings → Service accounts → Generate new private key
# Save JSON anywhere on disk and point at it (do NOT commit the file).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Master seed (used once by scripts/seed-master.ts, then can be removed)
MASTER_SEED_EMAIL=
MASTER_SEED_PASSWORD=
MASTER_SEED_DISPLAY_NAME=

# Future Shopify integration (placeholders, unused for MVP)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_SHOP_DOMAIN=
