rules_version = '2';

// Firestore rules for shopify.workmanis.lv
// SEPARATE project from Workmanis.lv — these rules apply only here.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isMaster()    { return isSignedIn() && role() == 'MASTER'; }
    function isAdmin()     { return isSignedIn() && role() == 'ADMIN'; }
    function isWarehouse() { return isSignedIn() && role() == 'WAREHOUSE'; }
    function isViewer()    { return isSignedIn() && role() == 'VIEWER'; }
    function isStaff()     { return isMaster() || isAdmin() || isWarehouse(); }
    function isAnyUser()   { return isMaster() || isAdmin() || isWarehouse() || isViewer(); }

    // -------- Users --------
    //   - Self read: any signed-in user can read their own /users doc
    //     (AuthProvider needs this to fetch the caller's role).
    //   - MASTER + ADMIN can read all user docs (Iestatījumi UI shows a list).
    //   - MASTER can create/update/delete any user doc.
    //   - Write API (POST /api/admin/users) uses the admin SDK and bypasses
    //     these rules; ADMIN-driven creates happen there, not via client SDK.
    match /users/{uid} {
      allow read:  if isMaster() || isAdmin() || request.auth.uid == uid;
      allow create, update, delete: if isMaster();
    }

    // -------- Pallets --------
    match /pallets/{palletId} {
      allow read:   if isAnyUser();
      allow create, update: if isMaster() || isAdmin();
      allow delete: if isMaster();
    }

    // -------- Products --------
    // Staff can read.
    // ADMIN + MASTER can create / fully update / delete.
    // WAREHOUSE can update operational fields plus pricing / lifecycle fields
    // they need from the per-product action panel and the stale-bucket bulk
    // actions on /products. UI restricts them to their own claimed pallets;
    // the rules stay coarse-grained because Firestore can't cheaply check
    // a transitive pallet-claim from inside a product write.
    match /products/{productId} {
      allow read:   if isAnyUser();
      allow create: if isMaster() || isAdmin();
      allow delete: if isMaster();
      allow update: if
        isMaster() || isAdmin()
        || (isWarehouse()
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'warehouseStatus',
                  'condition',
                  'images',
                  'finalPrice',
                  'listingDiscountPercent',
                  'customerNote',
                  'listingStatus',
                  'disposalReason',
                  'approvalStatus',
                  'listedAt',
                  'outletSaleAt',
                  'soldPrice',
                  'soldAt',
                  'updatedAt'
                ]));
    }

    // -------- Audit logs --------
    // Append-only by signed-in users.
    //   - MASTER + ADMIN can read all entries.
    //   - WAREHOUSE can read only their own entries (where userId == own uid).
    //   - VIEWER has no audit access.
    match /auditLogs/{logId} {
      allow read:   if isMaster()
                    || isAdmin()
                    || (isWarehouse() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // -------- Shopify connections (future) --------
    match /shopifyConnections/{id} {
      allow read, write: if isMaster() || isAdmin();
    }
  }
}
